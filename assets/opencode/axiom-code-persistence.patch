+import path from "path"
+
+export function requested(text: string) {
+  if (/\b(only|just|limited to)\b/i.test(text)) return false
+  return /\b(review|analy[sz]e|audit|understand|explain|inspect)\b/i.test(text) &&
+    /\b(repository|repo|codebase|project|architecture)\b/i.test(text)
+}
+
+export function stable(value: unknown): string {
+  if (Array.isArray(value)) return "[" + value.map(stable).join(",") + "]"
+  if (value && typeof value === "object") return "{" + Object.entries(value).sort(([a], [b]) => a.localeCompare(b))
+    .map(([key, item]) => JSON.stringify(key) + ":" + stable(item)).join(",") + "}"
+  return JSON.stringify(value) ?? "null"
+}
+
+export function promisesWork(text: string) {
+  return /^(?:I will|I'll|Let me|Next I will)\s+(?:now\s+)?(?:continue|read|inspect|check|implement|fix|analy[sz]e|review|run|examine)\b/i.test(text.trim()) && text.trim().length < 600
+}
+
+const extensions = new Set([".cs", ".xaml", ".csproj", ".props", ".targets", ".fs", ".vb", ".js", ".jsx", ".ts", ".tsx", ".py", ".go", ".rs", ".java", ".kt", ".c", ".h", ".cpp", ".hpp", ".swift", ".rb", ".php", ".html", ".css", ".scss", ".sql", ".sh", ".ps1", ".md"])
+
+export class Coverage {
+  readonly files: string[]
+  readonly omitted: string[]
+  readonly failures: string[] = []
+  index = 0
+  offset = 1
+  passes = 0
+  readonly maxPasses = 512
+  constructor(files: string[], readonly capped = false) {
+    const sorted = [...new Set(files)].sort()
+    this.files = sorted.filter((file) => extensions.has(path.extname(file).toLowerCase()))
+    this.omitted = sorted.filter((file) => !this.files.includes(file))
+  }
+  get pending() { return this.index < this.files.length && this.passes < this.maxPasses && this.failures.length === 0 }
+  next() { return { filePath: this.files[this.index], offset: this.offset, limit: 200 } }
+  accept(output: string, metadata: Record<string, unknown>) {
+    this.passes++
+    const display = metadata.display as { type?: string; lineEnd?: number; truncated?: boolean } | undefined
+    if (display?.type !== "file" || typeof display.lineEnd !== "number") {
+      this.failures.push(`${this.files[this.index]}: no text range returned`)
+      return
+    }
+    if (output.includes("... (line truncated to ")) {
+      this.failures.push(`${this.files[this.index]}: a source line exceeds the read tool's character limit`)
+      return
+    }
+    if (display.truncated) {
+      if (display.lineEnd < this.offset) {
+        this.failures.push(`${this.files[this.index]}: read made no progress`)
+        return
+      }
+      this.offset = display.lineEnd + 1
+      return
+    }
+    this.index++
+    this.offset = 1
+  }
+  receipt() {
+    return `[Axiom source coverage: ${this.index}/${this.files.length} eligible files supplied through ${this.passes} read passes; ${this.omitted.length} non-source files omitted. ` +
+      (this.capped ? "Inventory exceeded 10,000 entries. " : "") +
+      (this.index < this.files.length ? `INCOMPLETE. Next unread range: ${this.files[this.index]}:${this.offset}. ` : "") +
+      (this.failures.length ? this.failures.join("; ") + ". " : "") +
+      "Scope: non-ignored source under the current project directory. Supplied source is not proof of correct analysis.]"
+  }
+}
+
+export * as AxiomCoverage from "./axiom-coverage"
