@@ -0,0 +1,62 @@
+import { expect, test } from "bun:test"
+import { AxiomCoverage } from "../../src/session/axiom-coverage"
+
+test("large C# repository is exhausted without model discovery or todos", () => {
+  const files = Array.from({ length: 82 }, (_, i) => `src/Module${i}.cs`)
+  const coverage = new AxiomCoverage.Coverage([...files, "image.png"])
+  const seen = new Set<string>()
+  while (coverage.pending) {
+    const next = coverage.next()
+    const key = `${next.filePath}:${next.offset}`
+    expect(seen.has(key)).toBe(false)
+    seen.add(key)
+    const lines = next.filePath === "src/Module0.cs" ? 21401 : 30
+    const end = Math.min(lines, next.offset + next.limit - 1)
+    coverage.accept("source", { display: { type: "file", lineEnd: end, truncated: end < lines } })
+  }
+  expect(coverage.index).toBe(82)
+  expect(coverage.passes).toBe(189)
+  expect(coverage.omitted).toEqual(["image.png"])
+  expect(coverage.receipt()).not.toContain("INCOMPLETE")
+})
+
+test("byte cap progresses by returned range rather than requested range", () => {
+  const coverage = new AxiomCoverage.Coverage(["a.cs"])
+  coverage.accept("source", { display: { type: "file", lineEnd: 17, truncated: true } })
+  expect(coverage.next().offset).toBe(18)
+})
+
+test("no-progress and truncated source never claim completion", () => {
+  for (const output of ["source", "... (line truncated to 2000 chars)"]) {
+    const coverage = new AxiomCoverage.Coverage(["a.cs"])
+    coverage.accept(output, { display: { type: "file", lineEnd: 0, truncated: true } })
+    expect(coverage.pending).toBe(false)
+    expect(coverage.receipt()).toContain("INCOMPLETE")
+  }
+})
+
+test("budget exhaustion remains explicitly incomplete", () => {
+  const coverage = new AxiomCoverage.Coverage(["huge.cs"], true)
+  while (coverage.pending) coverage.accept("source", { display: { type: "file", lineEnd: coverage.offset, truncated: true } })
+  expect(coverage.passes).toBe(512)
+  expect(coverage.receipt()).toContain("INCOMPLETE")
+  expect(coverage.receipt()).toContain("10,000")
+})
+
+test("coverage only activates for broad analysis requests", () => {
+  expect(AxiomCoverage.requested("Analyze this C# repository")).toBe(true)
+  expect(AxiomCoverage.requested("Review the codebase and fix defects")).toBe(true)
+  expect(AxiomCoverage.requested("Fix the login button")).toBe(false)
+  expect(AxiomCoverage.requested("Review only login.cs in this project")).toBe(false)
+})
+
+test("statements of intent are not successful completion without a todo list", () => {
+  expect(AxiomCoverage.promisesWork("I will now read the remaining files.")).toBe(true)
+  expect(AxiomCoverage.promisesWork("Let me continue with the implementation.")).toBe(true)
+  expect(AxiomCoverage.promisesWork("Implemented the fix and checked the result.")).toBe(false)
+})
+
+test("repeat keys preserve nested arguments and ignore property order", () => {
+  expect(AxiomCoverage.stable({ b: { x: 1 }, a: 2 })).toBe(AxiomCoverage.stable({ a: 2, b: { x: 1 } }))
+  expect(AxiomCoverage.stable({ b: { x: 1 } })).not.toBe(AxiomCoverage.stable({ b: { y: 1 } }))
+})
