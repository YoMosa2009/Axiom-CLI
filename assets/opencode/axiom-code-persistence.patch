+          }
+
+          // AXIOM: the mirror image of the nudge above. That one refuses to stop too early; this
+          // one refuses to spin forever. Every repeat is a legitimate tool call, so nothing in the
+          // stock loop notices a model that has locked onto one. Tell it once, then stop.
+          const axiomRepeat = axiomRepeatedTail(msgs)
+          if (axiomRepeat && axiomRepeat.count >= AXIOM_REPEAT_WARN) {
+            if (axiomRepeat.count >= AXIOM_REPEAT_ABORT) {
+              yield* Effect.logWarning("axiom: aborting a locked tool-call loop", {
+                "session.id": sessionID,
+                tool: axiomRepeat.tool,
+                count: axiomRepeat.count,
+              })
+              break
+            }
+            yield* Effect.logInfo("axiom: breaking a repeated tool call", {
+              "session.id": sessionID,
+              tool: axiomRepeat.tool,
+              count: axiomRepeat.count,
+            })
+            const axiomRepeatMsg = msgs.findLast((msg) => msg.info.role === "user")
+            if (axiomRepeatMsg) {
+              axiomRepeatMsg.parts.push({
+                id: PartID.ascending(),
+                messageID: axiomRepeatMsg.info.id,
+                sessionID: axiomRepeatMsg.info.sessionID,
+                type: "text",
+                text: axiomRepeatText(axiomRepeat.tool, axiomRepeat.count),
+                synthetic: true,
+              })
+            }
           }
 
