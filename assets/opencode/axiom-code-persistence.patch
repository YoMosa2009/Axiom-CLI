-            yield* Effect.logInfo("exiting loop", { "session.id": sessionID })
-            break
+            // AXIOM: a 9-12B model routinely ends a turn by announcing its next step ("I will
+            // continue with the remaining modules...") instead of taking it. The loop is right
+            // that the turn produced no tool call, but the task plainly is not finished -- the
+            // model's own todo list still has unfinished items. Rather than accept that as
+            // completion, tell it what it just did and run the turn again. Bounded, and only
+            // ever triggered by the model's own recorded todos, so a genuinely finished task
+            // (every item completed, or no list at all) still exits immediately.
+            const axiomUnfinished = axiomUnfinishedTodos(msgs)
+            if (axiomUnfinished.length > 0 && axiomNudges < AXIOM_MAX_NUDGES) {
+              axiomNudges++
+              yield* Effect.logInfo("axiom: refusing a no-tool-call turn with unfinished todos", {
+                "session.id": sessionID,
+                nudge: axiomNudges,
+                unfinished: axiomUnfinished.length,
+              })
+              const axiomUserMsg = msgs.findLast((msg) => msg.info.role === "user")
+              if (axiomUserMsg) {
+                // Deliberately in-memory only: the nudge steers this one retry and must not
+                // pile up in the persisted transcript across turns.
+                axiomUserMsg.parts.push({
+                  id: PartID.ascending(),
+                  messageID: axiomUserMsg.info.id,
+                  sessionID: axiomUserMsg.info.sessionID,
+                  type: "text",
+                  text: axiomContinueText(axiomUnfinished),
+                  synthetic: true,
+                })
+              }
+            } else {
+              yield* Effect.logInfo("exiting loop", { "session.id": sessionID })
+              break
+            }
+          } else {
+            axiomNudges = 0
           }
 
