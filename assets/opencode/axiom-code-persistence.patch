+// The model's own todo list, as last written by the todowrite tool. Read from the message parts
+// rather than the Todo service so this stays a self-contained change with no new dependency on
+// the loop's Effect context.
+function axiomUnfinishedTodos(messages: SessionV1.WithParts[]): string[] {
+  for (let m = messages.length - 1; m >= 0; m--) {
+    const parts = messages[m].parts
+    for (let p = parts.length - 1; p >= 0; p--) {
+      const part = parts[p]
+      if (part.type !== "tool" || part.tool !== "todowrite") continue
+      if (part.state.status !== "completed") continue
+      const todos = part.state.metadata?.todos
+      if (!Array.isArray(todos)) continue
+      return todos
+        .filter((todo) => todo && todo.status !== "completed" && todo.status !== "cancelled")
+        .map((todo) => String(todo.content ?? "").trim())
+        .filter((content) => content.length > 0)
+    }
+  }
+  return []
+}
+
+// Length of the trailing run of identical assistant answers. A model that believes it is finished
+// answers any nudge by re-emitting the same text verbatim -- measured on a real session as four
+// byte-identical 1,899-character answers in a row -- so this is the signal that pushing again is
+// pointless no matter what the todo list still says.
+function axiomRepeatedAnswers(messages: SessionV1.WithParts[]): number {
+  const answers: string[] = []
+  for (const message of messages) {
+    if (message.info.role !== "assistant") continue
+    const text = message.parts
+      .map((part) => (part.type === "text" && !part.synthetic ? part.text : ""))
+      .join("")
+      .trim()
+    if (text.length > 0) answers.push(text)
+  }
+  if (answers.length < 2) return answers.length
+  let count = 1
+  for (let i = answers.length - 2; i >= 0 && answers[i] === answers[answers.length - 1]; i--) count++
+  return count
+}
+
+// Files the model's own searches turned up but never opened. Derived purely from the transcript --
+// glob output lines minus read inputs -- so it needs no extra IO and no new service dependency.
+function axiomUnreadFiles(messages: SessionV1.WithParts[], limit: number): string[] {
+  const found = new Set<string>()
+  const read = new Set<string>()
+  for (const message of messages) {
+    for (const part of message.parts) {
+      if (part.type !== "tool" || part.state.status !== "completed") continue
