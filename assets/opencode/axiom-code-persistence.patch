+// AXIOM: how many no-tool-call turns the loop will refuse in a row before accepting that the
+// model really is finished. High enough to carry a long multi-file review past several stumbles,
+// low enough that a model with nothing left to say still terminates promptly.
+const AXIOM_MAX_NUDGES = 6
+
+// The model's own todo list, as last written by the todowrite tool. Read from the message parts
+// rather than the Todo service so this stays a self-contained change with no new dependency on
+// the loop's Effect context.
+function axiomUnfinishedTodos(messages: SessionV1.WithParts[]): string[] {
+  for (let m = messages.length - 1; m >= 0; m--) {
+    const parts = messages[m].parts
+    for (let p = parts.length - 1; p >= 0; p--) {
+      const part = parts[p]
+      if (part.type !== "tool" || part.tool !== "todowrite") continue
+      if (part.state.status !== "completed") continue
+      const todos = part.state.metadata?.todos
+      if (!Array.isArray(todos)) continue
+      return todos
+        .filter((todo) => todo && todo.status !== "completed" && todo.status !== "cancelled")
+        .map((todo) => String(todo.content ?? "").trim())
+        .filter((content) => content.length > 0)
+    }
+  }
+  return []
+}
+
+// Length of the trailing run of identical assistant answers. A model that believes it is finished
+// answers any nudge by re-emitting the same text verbatim -- measured on a real session as four
+// byte-identical 1,899-character answers in a row -- so this is the signal that pushing again is
+// pointless no matter what the todo list still says.
+function axiomRepeatedAnswers(messages: SessionV1.WithParts[]): number {
+  const answers: string[] = []
+  for (const message of messages) {
+    if (message.info.role !== "assistant") continue
+    const text = message.parts
+      .map((part) => (part.type === "text" && !part.synthetic ? part.text : ""))
+      .join("")
+      .trim()
+    if (text.length > 0) answers.push(text)
+  }
+  if (answers.length < 2) return answers.length
+  let count = 1
+  for (let i = answers.length - 2; i >= 0 && answers[i] === answers[answers.length - 1]; i--) count++
+  return count
+}
+
+// Files the model's own searches turned up but never opened. Derived purely from the transcript --
+// glob output lines minus read inputs -- so it needs no extra IO and no new service dependency.
+function axiomUnreadFiles(messages: SessionV1.WithParts[], limit: number): string[] {
+  const found = new Set<string>()
+  const read = new Set<string>()
+  for (const message of messages) {
+    for (const part of message.parts) {
+      if (part.type !== "tool" || part.state.status !== "completed") continue
+      if (part.tool === "read") {
+        const target = (part.state.input as { filePath?: string })?.filePath
+        if (typeof target === "string") read.add(target.trim())
+        continue
+      }
+      if (part.tool !== "glob") continue
+      for (const line of String(part.state.output ?? "").split("\n")) {
+        const candidate = line.trim()
+        // Skip the blank line and the "(Results are truncated...)" footer glob appends.
+        if (candidate.length === 0 || candidate.startsWith("(")) continue
+        if (!candidate.includes(".")) continue
+        found.add(candidate)
+      }
+    }
+  }
+  const unread: string[] = []
+  for (const candidate of found) {
+    if (read.has(candidate)) continue
+    unread.push(candidate)
+    if (unread.length >= limit) break
+  }
+  return unread
+}
+
+// Whether any search has ever returned a file. An empty result set is not evidence of an
+// empty project -- it usually means the pattern was wrong.
+function axiomFoundAnyFile(messages: SessionV1.WithParts[]): boolean {
+  return axiomUnreadFiles(messages, 1).length > 0 || messages.some((message) =>
+    message.parts.some(
+      (part) => part.type === "tool" && part.tool === "read" && part.state.status === "completed",
+    ),
+  )
+}
+
+// AXIOM: identical consecutive tool calls before the loop intervenes, and before it gives up.
+// Measured: Gemma 4 12B issued the byte-identical glob 370 times in a row, receiving the same
+// result every time, for 24 minutes -- a hard repetition lock, and nothing in the stock loop
+// stops it because each repeat is a legitimate tool call.
+const AXIOM_REPEAT_WARN = 3
+const AXIOM_REPEAT_ABORT = 8
+
+// Length of the trailing run of byte-identical tool calls (same tool, same input).
+function axiomRepeatedTail(messages: SessionV1.WithParts[]): { tool: string; count: number } | undefined {
+  const calls: { tool: string; key: string }[] = []
+  for (const message of messages) {
+    if (message.info.role !== "assistant") continue
+    for (const part of message.parts) {
+      if (part.type !== "tool") continue
+      if (part.state.status !== "completed" && part.state.status !== "error") continue
+      calls.push({ tool: part.tool, key: part.tool + " " + JSON.stringify(part.state.input ?? {}) })
+    }
+  }
+  if (calls.length === 0) return undefined
+  const last = calls[calls.length - 1]
+  let count = 1
+  for (let i = calls.length - 2; i >= 0 && calls[i].key === last.key; i--) count++
+  return { tool: last.tool, count }
+}
+
+function axiomRepeatText(tool: string, count: number): string {
+  return [
+    `You have now called \`${tool}\` ${count} times in a row with exactly the same arguments, and`,
+    "received exactly the same result every time. Repeating it again cannot tell you anything new.",
+    "",
+    "Use the result you already have. Move to a different action: read one of the files it returned,",
+    "or work on the next unfinished item on your todo list. Do not call `" + tool + "` with those",
+    "arguments again.",
+  ].join("\n")
+}
+
+function axiomContinueText(unfinished: string[], unread: string[], searchedSuccessfully: boolean): string {
+  const lines = [
+    "You ended that turn without calling a tool, but your own todo list still has unfinished work:",
+    ...unfinished.map((item) => "  - " + item),
+    "",
+    "Saying what you will do next does not do it, and nothing will prompt you again: a turn that",
+    "ends without a tool call ends the entire task.",
+  ]
+  if (unread.length > 0) {
+    // Naming actual paths is what makes this actionable. Told only "you have unfinished todos",
+    // the model concludes it is already done and re-sends the same summary.
+    lines.push(
+      "",
+      "You have not opened these files, which your own searches returned:",
+      ...unread.map((file) => "  - " + file),
+    )
+  } else if (!searchedSuccessfully) {
+    // Measured: the model globbed for every language except the one the project is written in
+    // (js/ts/py/go/rs/java/... against a C# repository), got nothing twice, and had no idea the
+    // files existed. Do not let it conclude anything from an empty search.
+    lines.push(
+      "",
+      "Your searches have not returned a single file yet, so you have not seen this project at",
+      "all. Do not draw any conclusion from that. Run `glob` with the pattern `**/*` to list what",
+      "is actually here before going further -- do not guess at file extensions.",
+    )
+  }
+  lines.push(
+    "",
+    "Do NOT write another summary -- your previous message already contained one, and repeating it",
+    "wastes the turn. Call `read` on a file you have not opened yet, or take the next concrete",
+    "action for the first unfinished item. When the work is genuinely done, mark the items",
+    "completed with todowrite and give your final answer in that same turn.",
+  )
+  return lines.join("\n")
+}
